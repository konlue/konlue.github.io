---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    transition:name="page-content"
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6 hero-dots">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {config.site.author}
      </h1>
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}subscribe/`}
        class="inline-block"
        aria-label="订阅本博客"
        title="订阅本博客（RSS）"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">订阅本博客</span>
      </a>

      <div
        id="state-flow"
        class="text-muted-foreground my-4 flex flex-wrap items-center gap-x-1.5 font-mono text-sm"
        aria-label="当前状态"
      >
        <span class="flow-node">2027 届在读</span>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span class="flow-node">全栈实习 2026.04–08</span>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span
          class="flow-node flow-current bg-accent/10 text-accent rounded-sm px-1.5 py-0.5 font-semibold"
          >求职中</span
        >
      </div>

      <p>
        Java 后端 / AI 应用方向。这里写我做过和想明白的东西：跨系统回调的安全设计、缓存与查询优化，以及用
        LangGraph 编排 Agent
        工作流的实践——每篇都来自真实项目里的实现与踩坑。
      </p>
      <p class="mt-2">
        开源项目{" "}
        <a
          target="_blank"
          href="https://github.com/konlue/dam-hub"
          class="hover:text-accent underline decoration-dashed underline-offset-4">dam-hub</a
        >{" "}
        （企业图素中台）+ {" "}
        <a
          target="_blank"
          href="https://github.com/konlue/dam-scout"
          class="hover:text-accent underline decoration-dashed underline-offset-4">dam-scout</a
        >{" "}
        （AI 素材策展助手），设计与实现细节见文章。
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    // 状态流转编排：每会话只播一次；reduced-motion 下直接静态呈现
    const stateFlow = document.getElementById("state-flow");
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (stateFlow && !reduceMotion && !sessionStorage.getItem("flow-played")) {
      stateFlow.classList.add("flow-play");
      sessionStorage.setItem("flow-played", "1");
    }
  });
</script>

<style>
  /* hero 点阵微背景：accent 色细点 + 径向渐隐，呼吸动画尊重减动效偏好 */
  .hero-dots {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .hero-dots::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(
      circle,
      var(--accent) 1px,
      transparent 1.5px
    );
    background-size: 22px 22px;
    opacity: 0.14;
    -webkit-mask-image: radial-gradient(
      120% 100% at 50% 0%,
      black 30%,
      transparent 78%
    );
    mask-image: radial-gradient(120% 100% at 50% 0%, black 30%, transparent 78%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-dots::before {
      animation: dots-breathe 9s ease-in-out infinite alternate;
    }
  }
  @keyframes dots-breathe {
    from {
      opacity: 0.08;
    }
    to {
      opacity: 0.18;
    }
  }
</style>

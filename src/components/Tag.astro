---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** 页面作用域：不同页面的标签不同名，避免跨页 morph 造成长距离飞行 */
  scope: string;
};

const { tag, tagName, size = "lg", scope } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

// 仅新增的标签（新旧页面无配对）默认不做任何过渡，这里补一个上浮淡入。
// 注意不要给 new 加 delay：有配对的标签走 morph 时，旧快照 0.15s 淡出，
// 延迟的新快照会让标签先消失再蹦出来（文章→标签页曾因此闪断）。
const tagAnimate = {
  forwards: {
    old: { name: "tag-out", duration: "0.15s", easing: "ease-in", fillMode: "both" },
    new: {
      name: "tag-in",
      duration: "0.28s",
      easing: "cubic-bezier(0.16, 1, 0.3, 1)",
      fillMode: "both",
    },
  },
  backwards: {
    old: { name: "tag-out", duration: "0.15s", easing: "ease-in", fillMode: "both" },
    new: {
      name: "tag-in",
      duration: "0.28s",
      easing: "cubic-bezier(0.16, 1, 0.3, 1)",
      fillMode: "both",
    },
  },
} as const;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={`tag-${scope}-${tag}`}
    transition:animate={tagAnimate}
    class:list={[
      "flex items-center gap-0.5",
      "border-foreground border-b-2 border-dashed",
      "hover:border-accent hover:text-accent hover:-mt-0.5",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
